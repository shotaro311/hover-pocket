{
  "$schema": "hoverpocket://schemas/capability-descriptor/v1",
  "id": "sticky.note.status",
  "version": 1,
  "titleKey": "capability.sticky.note.status",
  "effect": "private_read",
  "permissions": ["sticky.read"],
  "approvalPolicy": "permission_grant",
  "idempotency": "optional",
  "availability": {
    "macos": "available",
    "windows": "available"
  },
  "limits": {
    "timeoutMs": 3000,
    "maxPayloadBytes": 4096,
    "maxCallsPerMinute": 120
  },
  "inputSchema": {
    "type": "object",
    "required": ["noteId"],
    "properties": {
      "noteId": {
        "type": "string",
        "format": "uuid"
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": ["noteId", "state", "updatedAt"],
    "properties": {
      "noteId": {
        "type": "string",
        "format": "uuid"
      },
      "state": {
        "type": "string",
        "enum": ["active", "archived", "missing"]
      },
      "updatedAt": {
        "type": ["string", "null"],
        "format": "date-time"
      }
    },
    "additionalProperties": false
  },
  "readback": {
    "strategy": "same_store_snapshot",
    "match": ["noteId", "state", "updatedAt"]
  }
}
