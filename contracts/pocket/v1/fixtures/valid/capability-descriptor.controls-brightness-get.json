{
  "$schema": "hoverpocket://schemas/capability-descriptor/v1",
  "id": "controls.brightness.get",
  "version": 1,
  "titleKey": "capability.controls.brightness.get",
  "effect": "private_read",
  "permissions": ["controls.read"],
  "approvalPolicy": "permission_grant",
  "idempotency": "optional",
  "availability": {"macos": "available", "windows": "available"},
  "limits": {"timeoutMs": 3000, "maxPayloadBytes": 4096, "maxCallsPerMinute": 120},
  "inputSchema": {
    "type": "object",
    "required": ["displayId"],
    "properties": {
      "displayId": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": ["displayId", "level", "controllable"],
    "properties": {
      "displayId": {"type": "string", "minLength": 1, "maxLength": 128},
      "level": {"type": "number", "minimum": 0, "maximum": 1},
      "controllable": {"type": "boolean", "const": true}
    },
    "additionalProperties": false
  },
  "readback": {"strategy": "same_store_snapshot", "match": ["displayId", "level", "controllable"]}
}
