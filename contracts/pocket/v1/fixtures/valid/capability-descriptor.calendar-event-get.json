{
  "$schema": "hoverpocket://schemas/capability-descriptor/v1",
  "id": "calendar.event.get",
  "version": 1,
  "titleKey": "capability.calendar.event.get",
  "effect": "private_read",
  "permissions": [
    "calendar.events.read"
  ],
  "approvalPolicy": "permission_grant",
  "idempotency": "optional",
  "availability": {
    "macos": "available",
    "windows": "available"
  },
  "limits": {
    "timeoutMs": 3000,
    "maxPayloadBytes": 4096,
    "maxCallsPerMinute": 120
  },
  "inputSchema": {
    "type": "object",
    "required": [
      "eventRef"
    ],
    "properties": {
      "eventRef": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "eventRef",
      "eventId",
      "start",
      "end",
      "safeTitle"
    ],
    "properties": {
      "eventRef": {
        "type": "string",
        "maxLength": 256
      },
      "eventId": {
        "type": "string",
        "maxLength": 256
      },
      "start": {
        "type": "string",
        "format": "date-time"
      },
      "end": {
        "type": "string",
        "format": "date-time"
      },
      "safeTitle": {
        "type": "string",
        "maxLength": 160
      }
    },
    "additionalProperties": false
  },
  "readback": {
    "strategy": "same_store_snapshot",
    "match": [
      "eventRef",
      "eventId",
      "start",
      "end",
      "safeTitle"
    ]
  }
}
