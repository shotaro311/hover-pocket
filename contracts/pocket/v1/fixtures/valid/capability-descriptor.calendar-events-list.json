{
  "$schema": "hoverpocket://schemas/capability-descriptor/v1",
  "id": "calendar.events.list",
  "version": 1,
  "titleKey": "capability.calendar.events.list",
  "effect": "private_read",
  "permissions": [
    "calendar.events.read"
  ],
  "approvalPolicy": "permission_grant",
  "idempotency": "optional",
  "availability": {
    "macos": "available",
    "windows": "available"
  },
  "limits": {
    "timeoutMs": 3000,
    "maxPayloadBytes": 4096,
    "maxCallsPerMinute": 120
  },
  "inputSchema": {
    "type": "object",
    "required": [
      "range",
      "timezone"
    ],
    "properties": {
      "range": {
        "type": "string",
        "enum": [
          "today"
        ]
      },
      "timezone": {
        "type": "string",
        "pattern": "^(?:UTC|Etc/UTC|[A-Za-z_]+(?:/[A-Za-z0-9._+-]+)+)$",
        "maxLength": 64
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "events"
    ],
    "properties": {
      "events": {
        "type": "array",
        "maxItems": 128,
        "items": {
          "type": "object",
          "required": [
            "eventRef",
            "start",
            "end",
            "safeTitle"
          ],
          "properties": {
            "eventRef": {
              "type": "string",
              "maxLength": 256
            },
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            },
            "safeTitle": {
              "type": "string",
              "maxLength": 160
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "readback": {
    "strategy": "same_store_snapshot",
    "match": [
      "events"
    ]
  }
}
