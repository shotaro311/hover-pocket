{
  "$schema": "hoverpocket://schemas/capability-descriptor/v1",
  "id": "timer.countdown.stop",
  "version": 1,
  "titleKey": "capability.timer.countdown.stop",
  "effect": "reversible_local_write",
  "permissions": [
    "timer.write"
  ],
  "approvalPolicy": "broker_policy",
  "idempotency": "required",
  "availability": {
    "macos": "available",
    "windows": "available"
  },
  "limits": {
    "timeoutMs": 3000,
    "maxPayloadBytes": 4096,
    "maxCallsPerMinute": 120
  },
  "inputSchema": {
    "type": "object",
    "required": [
      "timerId"
    ],
    "properties": {
      "timerId": {
        "type": "string",
        "format": "uuid"
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "timerId",
      "state",
      "endAt"
    ],
    "properties": {
      "timerId": {
        "type": "string",
        "format": "uuid"
      },
      "state": {
        "const": "stopped"
      },
      "endAt": {
        "type": "null"
      }
    },
    "additionalProperties": false
  },
  "readback": {
    "strategy": "capability_query",
    "capabilityId": "timer.countdown.get",
    "capabilityVersion": 1,
    "match": [
      "timerId",
      "state",
      "endAt"
    ]
  }
}
