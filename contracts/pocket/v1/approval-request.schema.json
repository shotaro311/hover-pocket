{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hoverpocket://schemas/approval-request/v1",
  "title": "HoverPocket broker-owned approval request v1",
  "type": "object",
  "required": [
    "$schema",
    "approvalRequestId",
    "planId",
    "planDigest",
    "principal",
    "createdAt",
    "expiresAt",
    "nonce",
    "effects",
    "requiredPermissions",
    "decisionOptions"
  ],
  "properties": {
    "$schema": {
      "const": "hoverpocket://schemas/approval-request/v1"
    },
    "approvalRequestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "maxLength": 128
    },
    "planId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "maxLength": 128
    },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "principal": {
      "type": "object",
      "required": [
        "userId"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "maxLength": 128
        },
        "pocketAppId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9][a-z0-9-]*){2,}$",
          "maxLength": 160
        },
        "agentSessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "minLength": 16,
      "maxLength": 128
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      },
      "minItems": 1,
      "maxItems": 32
    },
    "requiredPermissions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*)+$",
        "maxLength": 128
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "decisionOptions": {
      "const": [
        "approve",
        "reject"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "effect": {
      "type": "object",
      "required": [
        "stepId",
        "capabilityId",
        "capabilityVersion",
        "effect",
        "argumentDigest",
        "summaryKey",
        "rollbackAvailable"
      ],
      "properties": {
        "stepId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "capabilityId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*){2,}$",
          "maxLength": 128
        },
        "capabilityVersion": {
          "type": "integer",
          "minimum": 1
        },
        "effect": {
          "type": "string",
          "enum": [
            "pure",
            "private_read",
            "reversible_local_write",
            "external_write",
            "destructive_sensitive",
            "native_authority"
          ]
        },
        "argumentDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "summaryKey": {
          "type": "string",
          "pattern": "^approval\\.[a-z0-9_.]+$",
          "maxLength": 160
        },
        "rollbackAvailable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
