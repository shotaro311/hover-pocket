{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hoverpocket://schemas/invocation/v1",
  "title": "HoverPocket CapabilityInvocation v1",
  "type": "object",
  "required": [
    "$schema",
    "invocationId",
    "capabilityId",
    "capabilityVersion",
    "origin",
    "principal",
    "planId",
    "planDigest",
    "arguments",
    "idempotencyKey",
    "traceId",
    "createdAt"
  ],
  "properties": {
    "$schema": {
      "const": "hoverpocket://schemas/invocation/v1"
    },
    "invocationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "maxLength": 128
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*){2,}$",
      "maxLength": 128
    },
    "capabilityVersion": {
      "type": "integer",
      "minimum": 1
    },
    "origin": {
      "type": "string",
      "enum": [
        "native_ui",
        "voice",
        "text",
        "pocket_surface",
        "mcp",
        "connector"
      ]
    },
    "principal": {
      "type": "object",
      "required": [
        "userId"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "maxLength": 128
        },
        "pocketAppId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9][a-z0-9-]*){2,}$",
          "maxLength": 160
        },
        "agentSessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "appContext": {
      "$ref": "#/$defs/appContext"
    },
    "planId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "maxLength": 128
    },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "arguments": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64
      },
      "additionalProperties": {
        "$ref": "#/$defs/anyJson"
      }
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "minLength": 16,
      "maxLength": 128
    },
    "traceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "maxLength": 128
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "appContext": {
      "type": "object",
      "required": [
        "id",
        "version",
        "manifestDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9][a-z0-9-]*){2,}$",
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "maxLength": 64
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "anyJson": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anyJson"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/anyJson"
          }
        }
      ]
    }
  }
}
