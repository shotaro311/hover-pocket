<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <StartupObject>HoverPocket.Shell.Program</StartupObject>
    <Version>0.2.7</Version>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <GoogleOAuthClientId Condition="'$(GoogleOAuthClientId)' == ''"></GoogleOAuthClientId>
    <GoogleOAuthClientSecret Condition="'$(GoogleOAuthClientSecret)' == ''"></GoogleOAuthClientSecret>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="System.Management" Version="10.0.9" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <ProjectReference Include="..\HoverPocket.CodexSandboxSetup\HoverPocket.CodexSandboxSetup.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\HoverPocket.CodexSandboxSetup.Contracts\HoverPocket.CodexSandboxSetup.Contracts.csproj" />
  </ItemGroup>

  <Target Name="CopyCodexSandboxSetupHelper"
          AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <_CodexSandboxSetupHelperFiles Include="$(MSBuildThisFileDirectory)..\HoverPocket.CodexSandboxSetup\bin\$(Configuration)\net10.0-windows10.0.22621.0\HoverPocket.CodexSandboxSetup.exe" />
      <_CodexSandboxSetupHelperFiles Include="$(MSBuildThisFileDirectory)..\HoverPocket.CodexSandboxSetup\bin\$(Configuration)\net10.0-windows10.0.22621.0\HoverPocket.CodexSandboxSetup.dll" />
      <_CodexSandboxSetupHelperFiles Include="$(MSBuildThisFileDirectory)..\HoverPocket.CodexSandboxSetup\bin\$(Configuration)\net10.0-windows10.0.22621.0\HoverPocket.CodexSandboxSetup.deps.json" />
      <_CodexSandboxSetupHelperFiles Include="$(MSBuildThisFileDirectory)..\HoverPocket.CodexSandboxSetup\bin\$(Configuration)\net10.0-windows10.0.22621.0\HoverPocket.CodexSandboxSetup.runtimeconfig.json" />
      <_CodexSandboxSetupHelperFiles Include="$(MSBuildThisFileDirectory)..\HoverPocket.CodexSandboxSetup\bin\$(Configuration)\net10.0-windows10.0.22621.0\HoverPocket.CodexSandboxSetup.Contracts.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_CodexSandboxSetupHelperFiles)"
          DestinationFolder="$(TargetDir)tools\codex-sandbox-setup"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="IncludeCodexSandboxSetupHelperInPublish"
          BeforeTargets="ComputeFilesToPublish"
          Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <_CodexSandboxSetupPublishFiles Include="$(MSBuildThisFileDirectory)..\HoverPocket.CodexSandboxSetup\bin\$(Configuration)\net10.0-windows10.0.22621.0\HoverPocket.CodexSandboxSetup.exe" />
      <_CodexSandboxSetupPublishFiles Include="$(MSBuildThisFileDirectory)..\HoverPocket.CodexSandboxSetup\bin\$(Configuration)\net10.0-windows10.0.22621.0\HoverPocket.CodexSandboxSetup.dll" />
      <_CodexSandboxSetupPublishFiles Include="$(MSBuildThisFileDirectory)..\HoverPocket.CodexSandboxSetup\bin\$(Configuration)\net10.0-windows10.0.22621.0\HoverPocket.CodexSandboxSetup.deps.json" />
      <_CodexSandboxSetupPublishFiles Include="$(MSBuildThisFileDirectory)..\HoverPocket.CodexSandboxSetup\bin\$(Configuration)\net10.0-windows10.0.22621.0\HoverPocket.CodexSandboxSetup.runtimeconfig.json" />
      <_CodexSandboxSetupPublishFiles Include="$(MSBuildThisFileDirectory)..\HoverPocket.CodexSandboxSetup\bin\$(Configuration)\net10.0-windows10.0.22621.0\HoverPocket.CodexSandboxSetup.Contracts.dll" />
      <ResolvedFileToPublish Include="@(_CodexSandboxSetupPublishFiles)"
                             RelativePath="tools\codex-sandbox-setup\%(Filename)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(GoogleOAuthClientId)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GoogleOAuthClientId</_Parameter1>
      <_Parameter2>$(GoogleOAuthClientId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(GoogleOAuthClientSecret)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GoogleOAuthClientSecret</_Parameter1>
      <_Parameter2>$(GoogleOAuthClientSecret)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\ui\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ui\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\..\Sources\HoverPocket\Resources\PocketApps\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>PocketApps\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
