<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\..\Resources\AppIcon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <StartupObject>HoverPocket.Shell.Program</StartupObject>
    <Version>0.2.13</Version>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <GoogleOAuthClientId Condition="'$(GoogleOAuthClientId)' == ''"></GoogleOAuthClientId>
    <GoogleOAuthClientSecret Condition="'$(GoogleOAuthClientSecret)' == ''"></GoogleOAuthClientSecret>
    <HoverPocketPublisherCertificateSha256 Condition="'$(HoverPocketPublisherCertificateSha256)' == ''"></HoverPocketPublisherCertificateSha256>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../../shared/asset-library/preview-formats.json" LogicalName="AssetLibrary.preview-formats.json" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <ProjectReference Include="..\HoverPocket.Assets\HoverPocket.Assets.csproj" />
    <EmbeddedResource Include="..\..\..\Resources\AppIcon.ico" LogicalName="HoverPocket.AppIcon.ico" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="System.Management" Version="10.0.9" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <ProjectReference Include="..\HoverPocket.CodexSandboxSetup\HoverPocket.CodexSandboxSetup.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\HoverPocket.CodexSandboxSetup.Contracts\HoverPocket.CodexSandboxSetup.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(HoverPocketPublisherCertificateSha256)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HoverPocketPublisherCertificateSha256</_Parameter1>
      <_Parameter2>$(HoverPocketPublisherCertificateSha256)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(GoogleOAuthClientId)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GoogleOAuthClientId</_Parameter1>
      <_Parameter2>$(GoogleOAuthClientId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(GoogleOAuthClientSecret)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GoogleOAuthClientSecret</_Parameter1>
      <_Parameter2>$(GoogleOAuthClientSecret)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../../artifacts/media-tools-windows/*" Link="MediaTools/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\Resources\ThirdParty\NAudio-LICENSE.txt" Link="ThirdParty\NAudio-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ui\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ui\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\..\Sources\HoverPocket\Resources\PocketApps\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>PocketApps\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <Target Name="BuildDevicePairing" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="cargo build --release --locked --manifest-path &quot;$(MSBuildProjectDirectory)\..\..\..\shared\pairing-helper\Cargo.toml&quot; --target-dir &quot;$(MSBuildProjectDirectory)\..\..\..\artifacts\pairing-helper-target&quot; -q" />
  </Target>
  <ItemGroup>
    <Content Include="..\..\..\artifacts\pairing-helper-target\release\hoverpocket-pairing.exe" Link="hoverpocket-pairing.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\shared\pairing-helper\LICENSE.txt" Link="ThirdParty\Pairing-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\shared\pairing-helper\NOTICE.md" Link="ThirdParty\Pairing-NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\shared\pairing-helper\THIRD-PARTY-LICENSES.html" Link="ThirdParty\Pairing-LICENSES.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
